# ===================================================================
# 환경 변수 템플릿
# 이 파일을 복사해서 .env 로 만든 뒤 실제 값을 채우세요.
# 실제 .env 파일은 .gitignore 에 의해 GitHub에 올라가지 않습니다.
# ===================================================================

# === [AI Agent API Key] ===
# Claude (Anthropic) — 사용 시에만 채움
ANTHROPIC_API_KEY=

# OpenAI — 사용 시에만 채움. 노출되면 즉시 https://platform.openai.com/api-keys 에서 revoke.
OPENAI_API_KEY=

# === [서버] ===
PORT=3001

# === [Firebase Admin (백엔드)] ===
# 서비스 계정 JSON 파일 경로. 참고/ 폴더는 .gitignore 처리됨.
GOOGLE_APPLICATION_CREDENTIALS=참고/your-firebase-adminsdk.json
FIREBASE_PROJECT_ID=
SUPER_ADMIN_EMAIL=
# Vite 클라이언트에서 데모 로그인 버튼이 사용하는 admin 이메일 (위와 동일하게)
VITE_SUPER_ADMIN_EMAIL=

# === [Store 백엔드 스위치] ===
# json: 로컬 JSON 파일 사용 (개발용)
# firestore: Firebase Firestore 사용 (운영)
STORE_BACKEND=json

# === [모킹 로그인 (로컬 dev 전용)] ===
# 기본 false. 로컬 개발에서 비밀번호 없이 이메일만으로 로그인하려면 true.
# Cloud Functions 런타임에서는 이 값과 무관하게 항상 차단됨 (하드닝).
DEV_MOCK_LOGIN_ENABLED=false

# === [Firebase Client (Vite 프론트엔드)] ===
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# === [API base URL] ===
# 빈값이면 동일 origin 사용 (개발 시 vite proxy 사용)
VITE_API_BASE=

# ===== 내부 통지 메일 (웨딩 랜딩 CTA 등) — 회사 메일 SMTP =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LANDING_NOTIFY_TO=

# ===== 알림 자동화 (A4) — Slack Incoming Webhook =====
# Slack 앱 → Incoming Webhooks → Add New Webhook to Workspace 에서 발급한 URL.
# 비밀값이므로 실제 값은 .env 에만 두고 절대 커밋하지 말 것.
# 비워두면 알림 발송이 조용히 skip 되고 서버는 정상 동작한다.
SLACK_WEBHOOK_URL=

# 알림 메시지 안의 행사 링크가 가리킬 주소. 비우면 운영 호스팅 주소를 쓴다.
APP_BASE_URL=
